{
	"name": "slnmix",
	"version": "0.23.0",
	"description": "tazuna に統合されました(npx tazuna pack / init / build)。このパッケージは引数をそのまま tazuna に渡す互換コマンドです。",
	"license": "MIT",
	"author": "Yuki Sakakibara",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ishibashi0112/slnmix.git"
	},
	"homepage": "https://github.com/ishibashi0112/slnmix#readme",
	"bugs": {
		"url": "https://github.com/ishibashi0112/slnmix/issues"
	},
	"bin": {
		"slnmix": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"keywords": [
		"repomix",
		"sln",
		"vbproj",
		"vb.net",
		"tazuna",
		"deprecated"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"compile-tests": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && tsc -p . --outDir out",
		"test": "npm run compile-tests && node --test \"out/test/**/*.test.js\"",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"tazuna": "^0.15.0"
	},
	"devDependencies": {
		"@types/node": "24.x",
		"typescript": "^6.0.3"
	}
}
